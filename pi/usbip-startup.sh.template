#!/bin/bash
# ZeroHub - Auto-bind all USB devices at boot (no network calls)
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG="/var/log/usbip-event.log"

sleep 8  # wait for USB devices to settle

echo "$(date '+%Y-%m-%d %H:%M:%S') STARTUP: scanning for devices to bind" >> "$LOG"

for dev in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
    [ -d "$dev" ] || continue
    BUSID=$(basename "$dev")
    echo "$BUSID" | grep -q ':' && continue
    CLASS=$(cat "$dev/bDeviceClass" 2>/dev/null)
    [ "$CLASS" = "09" ] && continue
    VENDOR=$(cat "$dev/idVendor" 2>/dev/null)
    [ -z "$VENDOR" ] && continue
    echo "$(date '+%Y-%m-%d %H:%M:%S') STARTUP BIND $BUSID" >> "$LOG"

    for attempt in 1 2 3; do
        RESULT=$(/usr/sbin/usbip bind -b "$BUSID" 2>&1)
        echo "$RESULT" >> "$LOG"
        if echo "$RESULT" | grep -q "complete\|already bound"; then
            break
        fi
        sleep 2
    done
done

echo "$(date '+%Y-%m-%d %H:%M:%S') STARTUP: binding complete" >> "$LOG"
